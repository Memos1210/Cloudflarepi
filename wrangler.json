{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pi-minute-counter",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "START_TIME_MS": "REPLACE_WITH_UNIX_TIME_MS",
    "START_INDEX": "0"
  }
}
